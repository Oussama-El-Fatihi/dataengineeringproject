          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "SELECT\n    DATE_TRUNC('month', TO_DATE(CONCAT(t.year, '-', t.month, '-01'), 'YYYY-MM-DD')) AS \"time\",\n    SUM(e.energy_production) AS \"Production in TWh\"\nFROM\n    Energy_Impact e\n    JOIN Time_Dim t ON e.time_id = t.time_id\nWHERE\n    e.country_id = $country\n    AND e.energy_type_id = $energy\n    AND t.year = $year\nGROUP BY\n    \"time\"\nORDER BY\n    \"time\"",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "type": "string"
                },
                "type": "groupBy"
              }
            ],
            "limit": 50
          }
        }
      ],
      "title": "Evolution of energy production: ${country}, ${energy}, year ${year}",
      "transparent": true,
      "type": "barchart"
