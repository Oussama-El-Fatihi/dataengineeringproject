          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\n    TO_DATE(t.year || '-' || LPAD(t.month::TEXT, 2, '0'), 'YYYY-MM') AS \"time\",\n    SUM(e.energy_production) AS \"Wind\"\nFROM\n    Energy_Impact e\n    JOIN Time_Dim t ON e.time_id = t.time_id\n    JOIN Energy_Type_Dim ed ON e.energy_type_id = ed.energy_type_id\nWHERE\n    ed.type_name = 'Wind'\n    AND e.country_id = $country \nGROUP BY\n    t.year, t.month\nORDER BY\n    t.year, t.month",
          "refId": "A",
