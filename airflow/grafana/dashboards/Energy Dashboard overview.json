          "rawSql": "SELECT\n    TO_DATE(t.year || '-' || LPAD(t.month::TEXT, 2, '0'), 'YYYY-MM') AS \"time\",\n    SUM(e.neutral_opinion) AS \"Neutral sentiment\"\nFROM\n    Energy_Impact e\n    JOIN Time_Dim t ON e.time_id = t.time_id\nWHERE\n    e.country_id = $country \n    AND e.energy_type_id = $energy \nGROUP BY\n    t.year, t.month\nORDER BY\n    t.year, t.month",
